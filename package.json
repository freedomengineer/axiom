{
    "name": "axiom",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "replica": "killall dfx icx-proxy && dfx start || dfx start",
        "replica:clean": "killall dfx icx-proxy && dfx start --clean || dfx start --clean",
        "replica:clean:background": "killall dfx icx-proxy && dfx start --clean --background || dfx start --clean --background",
        "deploy": "yarn analyze && npx tsx './scripts/deploy/local.ts'",
        "deploy:prod": "yarn analyze:prod && npx tsx './scripts/deploy/prod.ts'",
        "deploy:ic": "yarn analyze:prod && npx tsx './scripts/deploy/ic.ts'",
        "upgrade_frontend": "npx tsx './scripts/upgrade_frontend/local.ts'",
        "upgrade_frontend:prod": "npx tsx './scripts/upgrade_frontend/prod.ts'",
        "upgrade_frontend:ic": "npx tsx './scripts/upgrade_frontend/ic.ts'",
        "derive": "npx tsx './scripts/derive/local.ts'",
        "derive:prod": "npx tsx './scripts/derive/prod.ts'",
        "derive:ic": "npx tsx './scripts/derive/ic.ts'",
        "transfer_acorn": "chmod +x ./scripts/bash/transfer_acorn.sh && ./scripts/bash/transfer_acorn.sh",
        "transfer_acorn:prod": "chmod +x ./scripts/bash/transfer_acorn_prod.sh && ./scripts/bash/transfer_acorn_prod.sh",
        "transfer_acorn:ic": "chmod +x ./scripts/bash/transfer_acorn_ic.sh && ./scripts/bash/transfer_acorn_ic.sh",
        "transfer_icp": "chmod +x ./scripts/bash/transfer_icp.sh && ./scripts/bash/transfer_icp.sh",
        "transfer_icp:ic": "chmod +x ./scripts/bash/transfer_icp_ic.sh && ./scripts/bash/transfer_icp_ic.sh",
        "analyze": "npx tsx './scripts/analyze/local.ts'",
        "analyze:prod": "npx tsx './scripts/analyze/prod.ts'",
        "migrate": "yarn analyze && npx tsx './scripts/migrate/index.ts' && yarn analyze:prod",
        "shift_days": "chmod +x ./scripts/bash/shift_days.sh && ./scripts/bash/shift_days.sh",
        "setup": "yarn && yarn replica && yarn deploy",
        "test": "jest",
        "build": "DISABLE_ESLINT_PLUGIN=true vite build",
        "dev": "chmod +x ./scripts/bash/execute_frontend.sh && ./scripts/bash/execute_frontend.sh && vite",
        "format": "prettier --write . && eslint --fix .",
        "sources": "mops sources",
        "postinstall": "mops install"
    },
    "husky": {
        "hooks": {
            "pre-commit": ""
        }
    },
    "lint-staged": {
        "*.{css,scss,ts,tsx,js,jsx}": [
            "prettier --write . && eslint --fix ."
        ]
    },
    "resolutions": {
        "jackspeak": "2.1.1"
    },
    "dependencies": {
        "@dfinity/agent": "^2.2.0",
        "@dfinity/auth-client": "^2.2.0",
        "@dfinity/candid": "^2.2.0",
        "@dfinity/identity": "^2.2.0",
        "@dfinity/identity-secp256k1": "^1.2.0",
        "@dfinity/principal": "^2.2.0",
        "@dfinity/utils": "^2.2.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@material-tailwind/react": "^2.1.10",
        "@mui/material": "^6.3.1",
        "@mui/x-charts": "^7.23.2",
        "axios": "^1.4.0",
        "browser-image-compression": "^2.0.2",
        "clsx": "^2.1.0",
        "dexie": "^4.0.11",
        "dexie-react-hooks": "^1.1.7",
        "framer-motion": "^12.23.12",
        "isomorphic-fetch": "^3.0.0",
        "masonry-layout": "^4.2.2",
        "qrcode.react": "^4.2.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-helmet-async": "^2.0.4",
        "react-responsive-masonry": "^2.7.1",
        "react-router-dom": "^7.3.0",
        "react-toastify": "^11.0.2",
        "recharts": "^2.15.0",
        "timeago.js": "^4.0.2",
        "vite-plugin-environment": "^1.1.3",
        "vite-plugin-eslint": "^1.8.1",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.0.8"
    },
    "devDependencies": {
        "@types/isomorphic-fetch": "^0.0.39",
        "@types/node": "^20",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@types/react-responsive-masonry": "^2.6.0",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@typescript-eslint/eslint-plugin": "^7.2.0",
        "@typescript-eslint/parser": "^7.2.0",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.0.1",
        "dotenv": "^16.3.1",
        "esbuild": "^0.20.0",
        "eslint": "^8",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-typescript": "^3.6.1",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-prettier": "^5.1.3",
        "husky": "3.0.0",
        "ic-mops": "1.5.0",
        "jest": "^29.7.0",
        "lint-staged": "12.4.1",
        "mo-dev": "^0.11.2",
        "pem-file": "^1.0.1",
        "postcss": "^8",
        "postcss-nesting": "^12.0.2",
        "postcss-preset-env": "^9.5.2",
        "prettier": "^3.2.5",
        "prettier-plugin-motoko": "^0.5.3",
        "prettier-plugin-tailwindcss": "^0.5.11",
        "tailwind-merge": "^2.2.2",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.3",
        "vite": "^6.2.2",
        "vite-plugin-svgr": "^4.3.0"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
