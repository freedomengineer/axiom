import Nominee "nominees/Nominee";
import Nominees "nominees/Nominees";
import Proposal "proposals/Proposal";
import Proposals "proposals/Proposals";
import User "users/User";
import Commitments "../indicator/commitments/Commitments";
import Installation "../indicator/installations/Installation";
import Base "../../library/Base";
import Configs "../../library/Configs";
import Count "../../library/Count";
import Delegable "../../library/Delegable";
import Earning "../../library/Earning";
import Pagination "../../library/Pagination";
import Version "../../library/Version";
import UniformBinaryVotes "../../library/votes/UniformBinaryVotes";

module {
    public type DAO = actor {
        initialize : shared () -> async ();
        setConfigs : shared ([(Configs.Key, Configs.SharableValue)]) -> async ();
        putConfigs : shared ([(Configs.Key, Configs.SharableValue)]) -> async ();
        register : shared (Principal) -> async ();
        setCodeProposalFailed : shared (Nat, Text) -> async ();
        setCodeProposalExecuted : shared (Nat) -> async ();
        initializeCodeUploadSession : shared (Text, Version.UpdateLevel, Installation.ReleaseNotes, Commitments.Sharable) -> async ();
        cancelCodeUpload : shared () -> async ();
        openCodeProposal : shared (Text, Nat, Nat, Installation.ActorsConfigs) -> async Nat;
        openConfigsProposal : shared (Text, Nat, Nat, Installation.ActorsConfigs) -> async Nat;
        openWorkerProposal : shared (Text, Text, Nat, Nat) -> async Nat;
        openFieldProposal : shared (Text, Text, Text) -> async Nat;
        retryConfigsProposal : shared (Nat, Text, Nat, Nat, Installation.ActorsConfigs) -> async ();
        retryWorkerProposal : shared (Nat, Text, Nat, Nat) -> async ();
        retryFieldProposal : shared (Nat, Text, Text, Text) -> async ();
        voteProposal : shared (Nat, Delegable.Delegable<UniformBinaryVotes.Choice>) -> async ();
        enterElection : shared (Text) -> async ();
        leaveElection : shared () -> async ();
        updateNomineeTitle : shared (Text) -> async ();
        castBallots : shared ([Principal]) -> async ();
        withdrawAll : shared () -> async ();
        getConfig : query (Configs.Key) -> async Configs.SharableValue;
        getConfigs : query () -> async Configs.Sharable;
        getDaysInPeriod : query () -> async Count.Sharable;
        getNominee : query (Principal) -> async Nominee.Sharable;
        getNominees : query (Nominees.Filter, Base.Sort<Nominees.Sort>) -> async Nominees.Sharable;
        getNomineesPagination : query (Nominees.Filter, Base.Sort<Nominees.Sort>, Nat, Nat) -> async Pagination.Pagination<Nominee.Sharable>;
        getProposal : query (Nat) -> async Proposal.Sharable;
        getProposals : query (Proposals.Filter, Base.Sort<Proposals.Sort>) -> async Proposals.Sharable;
        getProposalsPagination : query (Proposals.Filter, Base.Sort<Proposals.Sort>, Nat, Nat) -> async Pagination.Pagination<Proposal.Sharable>;
        getUser : query (Principal) -> async User.Sharable;
        getEarning : query (Principal) -> async (Earning.Sharable, Earning.Sharable);
        expectUserNotFound : query (Principal) -> async ();
    };
};