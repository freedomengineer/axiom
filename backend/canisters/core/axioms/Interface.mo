import Evidence "evidences/Evidence";
import Evidences "evidences/Evidences";
import Field "fields/Field";
import Fields "fields/Fields";
import Flag "flags/Flag";
import Flags "flags/Flags";
import Hypotheses "hypotheses/Hypotheses";
import Hypothesis "hypotheses/Hypothesis";
import Payout "payouts/Payout";
import Payouts "payouts/Payouts";
import User "users/User";
import Base "../../library/Base";
import Configs "../../library/Configs";
import Earning "../../library/Earning";
import Pagination "../../library/Pagination";
import BinaryVotes "../../library/votes/BinaryVotes";
import TernaryVotes "../../library/votes/TernaryVotes";

module {
    public type Axioms = actor {
        shiftToMidnight : shared (Nat) -> async ();
        initialize : shared () -> async ();
        setConfigs : shared ([(Configs.Key, Configs.SharableValue)]) -> async ();
        putConfigs : shared ([(Configs.Key, Configs.SharableValue)]) -> async ();
        register : shared (Principal) -> async ();
        createField : shared (Text, Text) -> async ();
        joinField : shared (Text) -> async ();
        leaveField : shared (Text) -> async ();
        publishHypothesis : shared (Text, Text) -> async Nat;
        editHypothesis : shared (Nat, Text) -> async ();
        publishEvidence : shared (Nat, Evidence.Form, BinaryVotes.Choice, ?Nat) -> async Nat;
        requestFlag : shared (Flag.Header, Text) -> async ();
        voteHypothesis : shared (Nat, TernaryVotes.Choice) -> async ();
        voteEvidence : shared (Nat, BinaryVotes.Choice) -> async ();
        voteFlag : shared (Flag.Header, BinaryVotes.Choice) -> async ();
        removeHypothesisVote : shared (Nat) -> async ();
        removeEvidenceVote : shared (Nat) -> async ();
        removeFlagVote : shared (Flag.Header) -> async ();
        addToAxioms : shared (Nat) -> async ();
        addToBookmarks : shared (Nat) -> async ();
        removeFromAxioms : shared (Nat) -> async ();
        removeFromBookmarks : shared (Nat) -> async ();
        follow : shared (Principal) -> async ();
        unfollow : shared (Principal) -> async ();
        withdrawAll : shared () -> async ();
        getConfig : query (Configs.Key) -> async Configs.SharableValue;
        getConfigs : query () -> async Configs.Sharable;
        getField : query (Text) -> async Field.Sharable;
        getFields : query (Fields.Filter, Base.Sort<Fields.Sort>) -> async Fields.Sharable;
        getFieldsPagination : query (Fields.Filter, Base.Sort<Fields.Sort>, Nat, Nat) -> async Pagination.Pagination<Field.Sharable>;
        getHypothesis : query (Nat) -> async Hypothesis.Sharable;
        getHypotheses : query (Hypotheses.Filter, Base.Sort<Hypotheses.Sort>) -> async Hypotheses.Sharable;
        getHypothesesPagination : query (Hypotheses.Filter, Base.Sort<Hypotheses.Sort>, Nat, Nat) -> async Pagination.Pagination<Hypothesis.Sharable>;
        getEvidence : query (Nat) -> async Evidence.Sharable;
        getEvidences : query (Evidences.Filter, Base.Sort<Evidences.Sort>) -> async Evidences.Sharable;
        getEvidencesPagination : query (Evidences.Filter, Base.Sort<Evidences.Sort>, Nat, Nat) -> async Pagination.Pagination<Evidence.Sharable>;
        getFlag : query (Flag.Header) -> async Flag.Sharable;
        getFlags : query (Flags.Filter, Base.Sort<Flags.Sort>) -> async Flags.Sharable;
        getFlagsPagination : query (Flags.Filter, Base.Sort<Flags.Sort>, Nat, Nat) -> async Pagination.Pagination<Flag.Sharable>;
        getTop : query ({ #Influencers; #HypothesisPublishers; #EvidencePublishers; #HypothesisVoters; #EvidenceVoters; #AcornEarners }) -> async Pagination.TopNonPagination;
        getTopPagination : query ({ #Influencers; #HypothesisPublishers; #EvidencePublishers; #HypothesisVoters; #EvidenceVoters; #AcornEarners }, Nat, Nat) -> async Pagination.TopPagination;
        getAgePayout : query (Nat, Nat) -> async Payout.Sharable;
        getAgePayouts : query (Nat) -> async Payouts.Sharable;
        getAgesPayout : query (Nat) -> async Payouts.Sharable;
        getAgesPayouts : query () -> async [Payouts.Sharable];
        getUser : query (Principal) -> async User.Sharable;
        getEarning : query (Principal) -> async Earning.Sharable;
        expectUserNotFound : query (Principal) -> async ();
    };
};