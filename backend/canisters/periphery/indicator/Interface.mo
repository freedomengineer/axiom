import Actor "actors/Actor";
import Commitments "commitments/Commitments";
import Installation "installations/Installation";
import ACORNInterface "../../core/acorn/Interface";
import AffiliateInterface "../../core/affiliate/Interface";
import AxiomsInterface "../../core/axioms/Interface";
import EscrowInterface "../../core/escrow/Interface";
import ICPUSDInterface "../../core/icpusd/Interface";
import SalesInterface "../../core/sales/Interface";
import SplitInterface "../../core/split/Interface";
import TreasuryInterface "../../core/treasury/Interface";
import DAOInterface "../../periphery/dao/Interface";
import FacadeInterface "../../periphery/facade/Interface";
import Configs "../../library/Configs";
import Version "../../library/Version";

module {
    public type Indicator = actor {
        getCanisterTime : query () -> async Int;
        shiftToMidnight : shared (Nat) -> async ();
        addController : shared () -> async ();
        initialize : shared () -> async ();
        setConfigs : shared ([(Configs.Key, Configs.SharableValue)]) -> async ();
        putConfigs : shared ([(Configs.Key, Configs.SharableValue)]) -> async ();
        setActorsConfigs : shared (Installation.ActorsConfigs) -> async ();
        putActorsConfigs : shared (Installation.ActorsConfigs) -> async ();
        initializeFirstSession : shared (Version.UpdateLevel, Installation.ReleaseNotes, Commitments.Sharable) -> async ();
        initializeSession : shared (Principal, Text, Version.UpdateLevel, Installation.ReleaseNotes, Commitments.Sharable) -> async ();
        deleteSession : shared (Principal) -> async ();
        installCanisters : shared () -> async ();
        enqueueUpgradeTask : shared (Nat, Principal, Installation.ActorsConfigs) -> async ();
        extendInstallationExpiryDate : shared (Principal, Nat) -> async ();
        topUp : shared (Actor.Variant, Nat) -> async ();
        uploadCommitmentChunk : shared (Actor.DeployableVariant, Nat8, Blob, Text) -> async ();
        settleCommitment : shared (Actor.DeployableVariant) -> async ();
        clearCommitment : shared (Actor.DeployableVariant) -> async ();
        getActorInfo : shared (Actor.Variant) -> async Actor.Info;
        getActorsInfo : shared () -> async [(Actor.Variant, Actor.Info)];
        getInstallation : query (Principal) -> async Installation.Sharable;
        getInstallationWithTitle : query (Principal) -> async (Installation.Sharable, Text);
        getCommitmentUploadedChunks : query (Principal, Actor.DeployableVariant) -> async [Nat8];
        getCommitmentComputedModuleHash : query (Principal, Actor.DeployableVariant) -> async Text;
        checkInstallationSettled : query (Principal) -> async Bool;
        getVersion : query () -> async Version.Sharable;
        getVariant : query (Principal) -> async Actor.Variant;
        getPrincipal : query (Actor.Variant) -> async Principal;
        getPrincipals : query () -> async [(Actor.Variant, Principal)];
        getConfig : query (Configs.Key) -> async Configs.SharableValue;
        getConfigs : query () -> async Configs.Sharable;
        expectAuthorized : query (Principal, [Actor.Variant]) -> async ();
        expectUnreleased : query () -> async ();
        ACORN : query () -> async ACORNInterface.ACORN;
        ICPUSD : query () -> async ICPUSDInterface.ICPUSD;
        Treasury : query () -> async TreasuryInterface.Treasury;
        Split : query () -> async SplitInterface.Split;
        Affiliate : query () -> async AffiliateInterface.Affiliate;
        Escrow : query () -> async EscrowInterface.Escrow;
        Sales : query () -> async SalesInterface.Sales;
        Axioms : query () -> async AxiomsInterface.Axioms;
        DAO : query () -> async DAOInterface.DAO;
        Facade : query () -> async FacadeInterface.Facade;
    };
};