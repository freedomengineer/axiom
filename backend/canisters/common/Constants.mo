module {
    public let ICP_FEE : Nat = 10_000;
    public let ACORN_FEE : Nat = 0;

    public let ONE_SECOND : Nat = 1_000_000_000;
    public let ONE_MINUTE : Nat = 60_000_000_000;
    public let ONE_HOUR : Nat = 3_600_000_000_000;
    public let ONE_DAY : Nat = 86_400_000_000_000; // 24 * 60 * 60 * nanoseconds (1e9)
    public let ONE_YEAR : Int = 31_536_000_000_000_000; // 365 * 24 * 60 * 60 * nanoseconds (1e9)

    public let DAYS_IN_YEAR : Nat = 365
}
