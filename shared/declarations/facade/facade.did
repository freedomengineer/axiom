type Facade = 
 service {
   editAvatar: (opt Picture) -> ();
   editLinks: (vec Hyperlink__1) -> ();
   editLocation: (opt text) -> ();
   editUsername: (text) -> ();
   /// PUBLIC ////// ACCESSORS ////////////
   getConfig: (Key) -> (SharableValue) query;
   getConfigs: () -> (Sharable__2) query;
   getNotification: () -> (Sharable__1) query;
   getUser: (principal) -> (Sharable) query;
   getUserIdentifier: (IdentifierVariant) -> (Identifier) query;
   getUsers: (Filter, Sort) -> (vec Sharable) query;
   getUsersCount: () -> (nat) query;
   getUsersIdentifier: () -> (vec Identifier) query;
   getUsersPagination: (Filter, Sort, nat, nat) -> (Pagination) query;
   getUsersPrincipal: () -> (vec principal) query;
   /// PROTECTED ////// MODIFIERS ////////////
   initialize: () -> ();
   postSystemGenericNotification: (text, opt Hyperlink__1) -> ();
   postSystemNotification: (SystemVariantParam__1) -> ();
   postSystemNotifications: (SystemNotificationsBatch) -> ();
   postUserNotification: (principal, UserVariantParam__1) -> ();
   postUserNotifications: (principal, UserNotificationsBatch) -> ();
   postUsersNotification: (UsersBatch, UserVariantParam__1) -> ();
   postUsersNotifications: (UsersNotificationsBatch) -> ();
   putConfigs: (vec record {
                      Key;
                      SharableValue;
                    }) -> ();
   /// PUBLIC ////// MODIFIERS ////////////
   register: (text, nat, opt principal) -> ();
   setConfigs: (vec record {
                      Key;
                      SharableValue;
                    }) -> ();
   shiftToMidnight: (nat) -> ();
   updateCapitalRaised: (principal, nat) -> ();
 };
