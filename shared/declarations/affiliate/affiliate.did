type Value_2 = 
 variant {
   infinity;
   value: ValueProp_2;
 };
type Value_1 = 
 variant {
   infinity;
   value: ValueProp_1;
 };
type ValueProp_2 = 
 variant {
   exclusive: nat;
   inclusive: nat;
 };
type ValueProp_1 = 
 variant {
   exclusive: int;
   inclusive: int;
 };
type ValueProp = 
 variant {
   exclusive: float64;
   inclusive: float64;
 };
type Value = 
 variant {
   infinity;
   value: ValueProp;
 };
type TopResult = 
 vec record {
       principal;
       nat;
     };
type TopPagination = 
 record {
   callerRank: opt nat;
   is: nat;
   of: nat;
   result: TopResult;
 };
type TopNonPagination = 
 record {
   callerRank: opt nat;
   result: TopResult;
 };
type Time = int;
type Sharable__2 = 
 vec record {
       Key;
       SharableValue;
     };
type Sharable__1 = 
 record {
   balance: SharableE8S__1;
   lastWithdrawAt: Time;
   revenue: SharableE8S__1;
 };
type SharableValue = 
 variant {
   Bool: bool;
   Date: SharableDate;
   Duration: nat;
   E8S: SharableE8S;
   Float: float64;
   Nat: nat;
   Proportion: SharableProportion;
   RangeFloat: SharableRange;
   RangeInt: SharableRange_1;
   RangeNat: SharableRange_2;
   Text: text;
 };
type SharableRange_2 = 
 record {
   Value_2;
   Value_2;
 };
type SharableRange_1 = 
 record {
   Value_1;
   Value_1;
 };
type SharableRange = 
 record {
   Value;
   Value;
 };
type SharableProportion = 
 record {
   nat;
   nat;
 };
type SharableEarning = 
 record {
   balance: SharableE8S__1;
   lastWithdrawAt: Time;
   revenue: SharableE8S__1;
 };
type SharableE8S__1 = nat;
type SharableE8S = nat;
type SharableDate = nat;
type SharableCount = nat;
type Sharable = 
 record {
   earning: SharableEarning;
   referrals: SharableCount;
   referrer: opt principal;
 };
type Key = text;
type Affiliate = 
 service {
   /// PRIVATE ////// ACCESSORS ////////////
   expectUserNotFound: (principal) -> () query;
   fillReferrals: (principal, nat, opt principal) -> ();
   /// PUBLIC ////// ACCESSORS ////////////
   getConfig: (Key) -> (SharableValue) query;
   getConfigs: () -> (Sharable__2) query;
   getEarning: (principal) -> (Sharable__1) query;
   getTop: (variant {Referrals;}) -> (TopNonPagination) query;
   getTopPagination: (variant {Referrals;}, nat, nat) ->
    (TopPagination) query;
   getUser: (principal) -> (Sharable) query;
   /// PROTECTED ////// MODIFIERS ////////////
   initialize: () -> ();
   putConfigs: (vec record {
                      Key;
                      SharableValue;
                    }) -> ();
   setConfigs: (vec record {
                      Key;
                      SharableValue;
                    }) -> ();
   shiftToMidnight: (nat) -> ();
   /// PUBLIC ////// MODIFIERS ////////////
   withdrawAll: () -> ();
 };
service : () -> Affiliate
