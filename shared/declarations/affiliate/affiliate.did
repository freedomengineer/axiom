type Value_2 = 
 variant {
   infinity;
   value: ValueProp_2;
 };
type Value_1 = 
 variant {
   infinity;
   value: ValueProp_1;
 };
type ValueProp_2 = 
 variant {
   exclusive: nat;
   inclusive: nat;
 };
type ValueProp_1 = 
 variant {
   exclusive: int;
   inclusive: int;
 };
type ValueProp = 
 variant {
   exclusive: float64;
   inclusive: float64;
 };
type Value = 
 variant {
   infinity;
   value: ValueProp;
 };
type TopResult = 
 vec record {
       principal;
       nat;
     };
type TopPagination = 
 record {
   callerRank: opt nat;
   is: nat;
   of: nat;
   result: TopResult;
 };
type TopNonPagination = 
 record {
   callerRank: opt nat;
   result: TopResult;
 };
type Time = int;
type StatusVariant = 
 variant {
   Available;
   Failed;
   Locked;
   Redeemed;
 };
type Status = 
 variant {
   Available;
   Failed: record {
             by: principal;
             reason: text;
             timestamp: Time;
           };
   Locked: record {
             by: principal;
             timestamp: Time;
           };
   Redeemed: record {
               by: principal;
               timestamp: Time;
             };
 };
type Sort__1 = 
 variant {
   icpPaid;
   recent;
 };
type Sort_1 = 
 record {
   by: Sort__1;
   order: Order;
 };
type Sort = 
 record {
   by: PrivateSort;
   order: Order;
 };
type Sharable__4 = 
 vec record {
       Key;
       SharableValue;
     };
type Sharable__3 = vec SharableCoupon;
type Sharable__2 = 
 record {
   balance: SharableE8S;
   lastWithdrawAt: Time;
   revenue: SharableE8S;
 };
type Sharable__1 = 
 record {
   coupons: vec text;
   earning: SharableEarning;
   referrals: SharableCount;
   referrer: opt principal;
 };
type SharableValue = 
 variant {
   Bool: bool;
   Date: SharableDate;
   Duration: nat;
   E8S: SharableE8S;
   Float: float64;
   Nat: nat;
   Proportion: SharableProportion;
   RangeFloat: SharableRange;
   RangeInt: SharableRange_1;
   RangeNat: SharableRange_2;
   Text: text;
 };
type SharableRange_2 = 
 record {
   Value_2;
   Value_2;
 };
type SharableRange_1 = 
 record {
   Value_1;
   Value_1;
 };
type SharableRange = 
 record {
   Value;
   Value;
 };
type SharableProportion = 
 record {
   nat;
   nat;
 };
type SharableEarning = 
 record {
   balance: SharableE8S;
   lastWithdrawAt: Time;
   revenue: SharableE8S;
 };
type SharableE8S = nat;
type SharableDate = nat;
type SharableCoupon = 
 record {
   capitalRaised: nat;
   creationDate: Time;
   creator: principal;
   icpPaid: nat;
   key: text;
   status: Status;
 };
type SharableCount = nat;
type Sharable = 
 record {
   capitalRaised: nat;
   creationDate: Time;
   creator: principal;
   icpPaid: nat;
   key: text;
   status: Status;
 };
type PrivateSort = 
 variant {
   icpPaid;
   recent;
 };
type PrivateSharable__1 = vec PrivateSharableCoupon;
type PrivateSharableCoupon = 
 record {
   capitalRaised: nat;
   code: vec nat8;
   creationDate: Time;
   creator: principal;
   icpPaid: nat;
   key: text;
   status: Status;
 };
type PrivateSharable = 
 record {
   capitalRaised: nat;
   code: vec nat8;
   creationDate: Time;
   creator: principal;
   icpPaid: nat;
   key: text;
   status: Status;
 };
type PrivateFilter = 
 record {
   capitalRaised: opt nat;
   status: opt StatusVariant;
 };
type Pagination_1 = 
 record {
   is: nat;
   of: nat;
   result: vec Sharable;
 };
type Pagination = 
 record {
   is: nat;
   of: nat;
   result: vec PrivateSharable;
 };
type Order = 
 variant {
   ascending;
   descending;
 };
type Key = text;
type Filter = 
 record {
   capitalRaised: opt nat;
   creator: opt principal;
   status: opt StatusVariant;
 };
type Affiliate = 
 service {
   /// PUBLIC ////// MODIFIERS ////////////
   createCoupon: (capitalRaised: nat) -> (PrivateSharable);
   /// PUBLIC ////// ASSERTERS ////////////
   expectUserNotFound: ("principal": principal) -> () query;
   fillReferrals: ("principal": principal, icpPaid: nat, referrer:
    opt principal) -> ();
   /// PUBLIC ////// ACCESSORS ////////////
   getConfig: (key: Key) -> (SharableValue) query;
   getConfigs: () -> (Sharable__4) query;
   getCoupon: (key: text) -> (Sharable) query;
   getCoupons: (filter: Filter, sort: Sort_1) -> (Sharable__3) query;
   getCouponsPagination: (filter: Filter, sort: Sort_1, page: nat, limit:
    nat) -> (Pagination_1) query;
   getEarning: ("principal": principal) -> (Sharable__2) query;
   getPrivateCoupon: (key: text) -> (PrivateSharable) query;
   getPrivateCoupons: (filter: PrivateFilter, sort: Sort) ->
    (PrivateSharable__1) query;
   getPrivateCouponsPagination: (filter: PrivateFilter, sort: Sort, page:
    nat, limit: nat) -> (Pagination) query;
   getTop: (category: variant {
                        CouponGenerators;
                        Referrers;
                      }) -> (TopNonPagination) query;
   getTopPagination: (category: variant {
                                  CouponGenerators;
                                  Referrers;
                                }, page: nat, limit: nat) ->
    (TopPagination) query;
   getUser: ("principal": principal) -> (Sharable__1) query;
   getUserCouponTotal: ("principal": principal) -> (nat, nat) query;
   /// PROTECTED ////// MODIFIERS ////////////
   initialize: () -> ();
   lockCoupon: (code: vec nat8, "principal": principal) -> (Sharable);
   putConfigs: (entries: vec record {
                               Key;
                               SharableValue;
                             }) -> ();
   redeemCoupon: (code: vec nat8, "principal": principal) -> ();
   redeemCouponFailed: (code: vec nat8, "principal": principal, reason:
    text) -> ();
   setConfigs: (entries: vec record {
                               Key;
                               SharableValue;
                             }) -> ();
   shiftToMidnight: (days: nat) -> ();
   withdrawAll: () -> ();
 };
service : () -> Affiliate
