type Variant = 
 variant {
   ACORN;
   Affiliate;
   Assets;
   Axioms;
   Chat;
   DAO;
   Encyclopedia;
   Escrow;
   Facade;
   Founder;
   Frontend;
   ICPUSD;
   Indicator;
   Sales;
   Split;
   Treasury;
 };
type Value_2 = 
 variant {
   infinity;
   value: ValueProp_2;
 };
type Value_1 = 
 variant {
   infinity;
   value: ValueProp_1;
 };
type ValueProp_2 = 
 variant {
   exclusive: nat;
   inclusive: nat;
 };
type ValueProp_1 = 
 variant {
   exclusive: int;
   inclusive: int;
 };
type ValueProp = 
 variant {
   exclusive: float64;
   inclusive: float64;
 };
type Value = 
 variant {
   infinity;
   value: ValueProp;
 };
type Time = int;
type Split = 
 service {
   affiliateDeposit: (sender: principal, amount: nat) -> (nat);
   deposit: (sender: principal, amount: nat) -> ();
   externalTransfer: (recipient: principal, amount: nat) -> ();
   getBalance: (actorVariant: Variant) -> (Sharable) query;
   /// PUBLIC ////// ACCESSORS ////////////
   getConfig: (key: Key) -> (SharableValue) query;
   getConfigs: () -> (Sharable__4) query;
   getDistribution: (actorVariant: Variant) -> (Sharable__3) query;
   getDistributions: () -> (Sharable__2) query;
   getEarning: (actorVariant: Variant) -> (Sharable__1) query;
   getTotalBalance: () -> (Sharable) query;
   getTotalRevenue: () -> (Sharable) query;
   /// PUBLIC ////// MODIFIERS ////////////
   internalTransfer: (recipientVariant: Variant, amount: nat) -> ();
   putConfigs: (entries: vec record {
                               Key;
                               SharableValue;
                             }) -> ();
   /// PROTECTED ////// MODIFIERS ////////////
   setConfigs: (entries: vec record {
                               Key;
                               SharableValue;
                             }) -> ();
   shiftToMidnight: (days: nat) -> ();
 };
type Sharable__4 = 
 vec record {
       Key;
       SharableValue;
     };
type Sharable__3 = 
 record {
   actorVariant: ActorVariant;
   earning: SharableEarning;
   proportion: SharableProportion;
 };
type Sharable__2 = vec SharableDistribution;
type Sharable__1 = 
 record {
   balance: SharableE8S;
   lastWithdrawAt: Time;
   revenue: SharableE8S;
 };
type SharableValue = 
 variant {
   Bool: bool;
   Date: SharableDate;
   Duration: nat;
   E8S: SharableE8S;
   Float: float64;
   Nat: nat;
   Proportion: SharableProportion;
   RangeFloat: SharableRange;
   RangeInt: SharableRange_1;
   RangeNat: SharableRange_2;
   Text: text;
 };
type SharableRange_2 = 
 record {
   Value_2;
   Value_2;
 };
type SharableRange_1 = 
 record {
   Value_1;
   Value_1;
 };
type SharableRange = 
 record {
   Value;
   Value;
 };
type SharableProportion = 
 record {
   nat;
   nat;
 };
type SharableEarning = 
 record {
   balance: SharableE8S;
   lastWithdrawAt: Time;
   revenue: SharableE8S;
 };
type SharableE8S = nat;
type SharableDistribution = 
 record {
   actorVariant: ActorVariant;
   earning: SharableEarning;
   proportion: SharableProportion;
 };
type SharableDate = nat;
type Sharable = nat;
type Key = text;
type ActorVariant = 
 variant {
   ACORN;
   Affiliate;
   Assets;
   Axioms;
   Chat;
   DAO;
   Encyclopedia;
   Escrow;
   Facade;
   Founder;
   Frontend;
   ICPUSD;
   Indicator;
   Sales;
   Split;
   Treasury;
 };
service : () -> Split
