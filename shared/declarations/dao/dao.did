type Value_2 = 
 variant {
   infinity;
   value: ValueProp_2;
 };
type Value_1 = 
 variant {
   infinity;
   value: ValueProp_1;
 };
type ValueProp_2 = 
 variant {
   exclusive: nat;
   inclusive: nat;
 };
type ValueProp_1 = 
 variant {
   exclusive: int;
   inclusive: int;
 };
type ValueProp = 
 variant {
   exclusive: float64;
   inclusive: float64;
 };
type Value = 
 variant {
   infinity;
   value: ValueProp;
 };
type UpdateLevel = 
 variant {
   Major;
   Minor;
   Patch;
 };
type UniformBinaryVote = record {choice: Choice;};
type Time = int;
type TernaryVote = 
 record {
   choice: Choice__1;
   value: nat;
 };
type StatusVariant = 
 variant {
   Approved;
   Executed;
   Expired;
   Failed;
   Proposed;
   Rejected;
   Retried;
 };
type Status = 
 variant {
   Approved;
   Executed;
   Expired;
   Failed: text;
   Proposed;
   Rejected;
   Retried;
 };
type Sort__2 = 
 variant {
   token;
   voter;
 };
type Sort__1 = 
 variant {
   acornReward;
   icpReward;
   recent;
   updated;
 };
type Sort_1 = 
 record {
   by: Sort__2;
   order: Order;
 };
type Sort = 
 record {
   by: Sort__1;
   order: Order;
 };
type Sharable__8 = 
 vec record {
       Key;
       SharableValue;
     };
type Sharable__7 = nat;
type Sharable__6 = 
 record {
   balance: SharableE8S;
   lastWithdrawAt: Time;
   revenue: SharableE8S;
 };
type Sharable__5 = vec SharableNominee;
type Sharable__4 = 
 record {
   ballots: record {
              nat;
              nat;
            };
   callerBallot: opt nat;
   isCustodian: bool;
   "principal": principal;
   title: text;
 };
type Sharable__3 = vec SharableProposal;
type Sharable__2 = 
 record {
   acornReward: nat;
   callerVote: opt Delegable__1;
   content: text;
   detachment: SharableDetachment;
   icpReward: nat;
   id: nat;
   proposer: principal;
   timeline: vec Milestone;
   title: text;
   votes: record {
            vec principal;
            vec principal;
            vec principal;
            vec principal;
          };
 };
type Sharable__1 = 
 record {
   acornEarning: SharableEarning;
   ballots: vec record {
                  principal;
                  nat;
                };
   icpEarning: SharableEarning;
   lastUpdateBallot: Time;
   proposalVotes: vec record {
                        nat;
                        Delegable__1;
                      };
   proposals: vec nat;
   referendumVotes: vec record {
                          nat;
                          TernaryVote;
                        };
   referendums: vec nat;
 };
type SharableWorker = record {};
type SharableValue = 
 variant {
   Bool: bool;
   Date: SharableDate;
   Duration: nat;
   E8S: SharableE8S;
   Float: float64;
   Nat: nat;
   Proportion: SharableProportion;
   RangeFloat: SharableRange;
   RangeInt: SharableRange_1;
   RangeNat: SharableRange_2;
   Text: text;
 };
type SharableRange_2 = 
 record {
   Value_2;
   Value_2;
 };
type SharableRange_1 = 
 record {
   Value_1;
   Value_1;
 };
type SharableRange = 
 record {
   Value;
   Value;
 };
type SharableProposal = 
 record {
   acornReward: nat;
   callerVote: opt Delegable__1;
   content: text;
   detachment: SharableDetachment;
   icpReward: nat;
   id: nat;
   proposer: principal;
   timeline: vec Milestone;
   title: text;
   votes: record {
            vec principal;
            vec principal;
            vec principal;
            vec principal;
          };
 };
type SharableProportion = 
 record {
   nat;
   nat;
 };
type SharableNominee = 
 record {
   ballots: record {
              nat;
              nat;
            };
   callerBallot: opt nat;
   isCustodian: bool;
   "principal": principal;
   title: text;
 };
type SharableInstallation = 
 record {
   commitHash: text;
   commitments: SharableCommitments;
   releaseNotes: ReleaseNotes;
   updateLevel: UpdateLevel;
 };
type SharableField = 
 record {
   description: text;
   name: text;
 };
type SharableEarning = 
 record {
   balance: SharableE8S;
   lastWithdrawAt: Time;
   revenue: SharableE8S;
 };
type SharableE8S = nat;
type SharableDetachment = 
 variant {
   Code: SharableCode;
   Configs: SharableConfigs__1;
   Field: SharableField;
   Worker: SharableWorker;
 };
type SharableDate = nat;
type SharableConfigs__1 = record {actorsConfigs: ActorsConfigs;};
type SharableConfigs = 
 vec record {
       Key;
       SharableValue;
     };
type SharableCommitments = vec SharableCommitment;
type SharableCommitment = 
 record {
   actorVariant: DeployableActorVariant;
   args: vec nat8;
   moduleHash: text;
 };
type SharableCode = 
 record {
   actorsConfigs: ActorsConfigs;
   installation: SharableInstallation;
 };
type Sharable = vec SharableCommitment;
type ReleaseNotes = vec Changes;
type ProposalVariant = 
 variant {
   Code;
   Configs;
   Field;
   Worker;
 };
type Pagination_1 = 
 record {
   is: nat;
   of: nat;
   result: vec Sharable__4;
 };
type Pagination = 
 record {
   is: nat;
   of: nat;
   result: vec Sharable__2;
 };
type Order = 
 variant {
   ascending;
   descending;
 };
type Milestone = 
 record {
   date: Time;
   status: Status;
 };
type Key = text;
type Filter__1 = 
 record {
   isCustodian: opt bool;
   voter: opt principal;
 };
type Filter = 
 record {
   category: opt ProposalVariant;
   proposer: opt principal;
   status: opt StatusVariant;
   voter: opt principal;
 };
type DeployableActorVariant = 
 variant {
   ACORN;
   Affiliate;
   Axioms;
   DAO;
   Escrow;
   Facade;
   Frontend;
   ICPUSD;
   Indicator;
   Sales;
   Split;
   Treasury;
 };
type Delegable__1 = 
 variant {
   Default: UniformBinaryVote;
   Delegated: principal;
 };
type Delegable = 
 variant {
   Default: Choice;
   Delegated: principal;
 };
type DAO = 
 service {
   cancelCodeUpload: () -> ();
   castBallots: (principals: vec principal) -> ();
   enterElection: (title: text) -> ();
   /// PUBLIC ////// ASSERTERS ////////////
   expectUserNotFound: ("principal": principal) -> () query;
   /// PUBLIC ////// ACCESSORS ////////////
   getConfig: (key: Key) -> (SharableValue) query;
   getConfigs: () -> (Sharable__8) query;
   getDaysInPeriod: () -> (Sharable__7) query;
   getEarning: ("principal": principal) -> (Sharable__6, Sharable__6) query;
   getNominee: (nomineePrincipal: principal) -> (Sharable__4) query;
   getNominees: (filter: Filter__1, sort: Sort_1) -> (Sharable__5) query;
   getNomineesPagination: (filter: Filter__1, sort: Sort_1, page: nat, limit:
    nat) -> (Pagination_1) query;
   getProposal: (proposalId: nat) -> (Sharable__2) query;
   getProposals: (filter: Filter, sort: Sort) -> (Sharable__3) query;
   getProposalsPagination: (filter: Filter, sort: Sort, page: nat, limit:
    nat) -> (Pagination) query;
   getUser: ("principal": principal) -> (Sharable__1) query;
   /// PROTECTED ////// MODIFIERS ////////////
   initialize: () -> ();
   /// PUBLIC ////// MODIFIERS ////////////
   initializeCodeUploadSession: (commitHash: text, updateLevel: UpdateLevel,
    releaseNotes: ReleaseNotes, commitments: Sharable) -> ();
   leaveElection: () -> ();
   openCodeProposal: (content: text, acornReward: nat, icpReward: nat,
    actorsConfigs: ActorsConfigs) -> (nat);
   openConfigsProposal: (content: text, acornReward: nat, icpReward: 
    nat, actorsConfigs: ActorsConfigs) -> (nat);
   openFieldProposal: (content: text, name: text, description: text) -> (nat);
   openWorkerProposal: (title: text, content: text, acornReward: nat,
    icpReward: nat) -> (nat);
   putConfigs: (entries: vec record {
                               Key;
                               SharableValue;
                             }) -> ();
   register: ("principal": principal) -> ();
   retryConfigsProposal: (proposalId: nat, updatedContent: text,
    updatedAcornReward: nat, updatedIcpReward: nat, updatedActorsConfigs:
    ActorsConfigs) -> ();
   retryFieldProposal: (proposalId: nat, updatedContent: text, updatedName:
    text, updatedDescription: text) -> ();
   retryWorkerProposal: (proposalId: nat, updatedContent: text,
    updatedAcornReward: nat, updatedIcpReward: nat) -> ();
   setCodeProposalExecuted: (proposalId: nat) -> ();
   setCodeProposalFailed: (proposalId: nat, error: text) -> ();
   setConfigs: (entries: vec record {
                               Key;
                               SharableValue;
                             }) -> ();
   shiftToMidnight: (days: nat) -> ();
   updateNomineeTitle: (title: text) -> ();
   voteProposal: (proposalId: nat, choice: Delegable) -> ();
   withdrawAll: () -> ();
 };
type ConfigurableActorVariant = 
 variant {
   Affiliate;
   Axioms;
   DAO;
   Escrow;
   Facade;
   Indicator;
   Sales;
   Split;
   Treasury;
 };
type Choice__1 = 
 variant {
   Negative;
   Neutral;
   Positive;
 };
type Choice = 
 variant {
   Delegated;
   Negative;
   Positive;
 };
type Changes = 
 variant {
   Added: vec text;
   Changed: vec text;
   Fixed: vec text;
   Removed: vec text;
   Security: vec text;
 };
type ActorsConfigs = 
 vec record {
       ConfigurableActorVariant;
       SharableConfigs;
     };
service : () -> DAO
