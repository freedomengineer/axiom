type Value_2 = 
 variant {
   infinity;
   value: ValueProp_2;
 };
type Value_1 = 
 variant {
   infinity;
   value: ValueProp_1;
 };
type ValueProp_2 = 
 variant {
   exclusive: nat;
   inclusive: nat;
 };
type ValueProp_1 = 
 variant {
   exclusive: int;
   inclusive: int;
 };
type ValueProp = 
 variant {
   exclusive: float64;
   inclusive: float64;
 };
type Value = 
 variant {
   infinity;
   value: ValueProp;
 };
type TopResult = 
 vec record {
       principal;
       nat;
     };
type TopPagination = 
 record {
   callerRank: opt nat;
   is: nat;
   of: nat;
   result: TopResult;
 };
type TopNonPagination = 
 record {
   callerRank: opt nat;
   result: TopResult;
 };
type Time = int;
type Sharable__2 = vec SharableBurial;
type Sharable__1 = 
 vec record {
       Key;
       SharableValue;
     };
type SharableValue = 
 variant {
   Bool: bool;
   Date: SharableDate;
   Duration: nat;
   E8S: SharableE8S;
   Float: float64;
   Nat: nat;
   Proportion: SharableProportion;
   RangeFloat: SharableRange;
   RangeInt: SharableRange_1;
   RangeNat: SharableRange_2;
   Text: text;
 };
type SharableRange_2 = 
 record {
   Value_2;
   Value_2;
 };
type SharableRange_1 = 
 record {
   Value_1;
   Value_1;
 };
type SharableRange = 
 record {
   Value;
   Value;
 };
type SharableProportion = 
 record {
   nat;
   nat;
 };
type SharableE8S = nat;
type SharableDate = nat;
type SharableBurials = vec SharableBurial;
type SharableBurial = 
 record {
   amount: SharableE8S;
   claimableInterest: SharableE8S;
   coefficient: nat;
   expiryDate: Time;
   issueDate: Time;
 };
type Sharable = record {burials: SharableBurials;};
type Option = 
 variant {
   Double;
   Octuple;
   Perpetual;
   Quadruple;
   Single;
 };
type Key = text;
type Escrow = 
 service {
   /// PUBLIC ////// MODIFIERS ////////////
   bury: (amount: nat, option: Option) -> ();
   /// PUBLIC ////// ASSERTERS ////////////
   expectUserNotFound: ("principal": principal) -> () query;
   getBurials: ("principal": principal) -> (Sharable__2) query;
   getBuriedAmount: ("principal": principal) -> (nat) query;
   getClaimableAmount: ("principal": principal) -> (nat) query;
   /// PUBLIC ////// ACCESSORS ////////////
   getConfig: (key: Key) -> (SharableValue) query;
   getConfigs: () -> (Sharable__1) query;
   getExpiredAmount: ("principal": principal) -> (nat) query;
   getInterestAmount: ("principal": principal) -> (nat) query;
   getTop: (category: variant {
                        AcornBuriers;
                        PoweredVoters;
                      }) -> (TopNonPagination) query;
   getTopPagination: (category: variant {
                                  AcornBuriers;
                                  PoweredVoters;
                                }, page: nat, limit: nat) ->
    (TopPagination) query;
   getUser: ("principal": principal) -> (Sharable) query;
   getVotingPower: ("principal": principal) -> (nat) query;
   /// PROTECTED ////// MODIFIERS ////////////
   initialize: () -> ();
   putConfigs: (entries: vec record {
                               Key;
                               SharableValue;
                             }) -> ();
   register: ("principal": principal, initialAmount: nat) -> ();
   setConfigs: (entries: vec record {
                               Key;
                               SharableValue;
                             }) -> ();
   shiftToMidnight: (days: nat) -> ();
   transferFounderBurial: (from: principal, to: principal) -> ();
   withdrawAll: () -> ();
 };
service : () -> Escrow
