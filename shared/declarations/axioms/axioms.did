   getEarning: (principal) -> (Sharable__9) query;
   getEvidence: (nat) -> (Sharable__7) query;
   getEvidences: (Filter__3, Sort_3) -> (Sharable__8) query;
   getEvidencesPagination: (Filter__3, Sort_3, nat, nat) ->
