       EvidencePublishers;
       EvidenceVoters;
       HypothesisPublishers;
       HypothesisVoters;
       Influencers;
     }) -> (TopNonPagination) query;
   getTopPagination:
    (variant {
       AcornEarners;
       EvidencePublishers;
       EvidenceVoters;
       HypothesisPublishers;
       HypothesisVoters;
       Influencers;
     }, nat, nat) -> (TopPagination) query;
   getUser: (principal) -> (Sharable) query;
   /// PROTECTED ////// MODIFIERS ////////////
   initialize: () -> ();
   /// PUBLIC ////// MODIFIERS ////////////
   joinField: (text) -> ();
   leaveField: (text) -> ();
   publishEvidence: (nat, Form, Choice__1, opt nat) -> (nat);
