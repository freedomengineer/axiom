   shiftToMidnight: (nat) -> ();
   unfollow: (principal) -> ();
   voteEvidence: (nat, Choice__1, opt CustomValue) -> ();
   voteFlag: (Header, Choice__1) -> ();
   voteHypothesis: (nat, Choice, opt CustomValue) -> ();
   withdrawAll: () -> ();
 };
