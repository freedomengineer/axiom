type Axioms = 
 service {
   addToAxioms: (hypothesisId: nat) -> ();
   addToBookmarks: (hypothesisId: nat) -> ();
   createField: (name: text, description: text) -> ();
   editHypothesis: (hypothesisId: nat, content: text) -> ();
   /// PUBLIC ////// ASSERTERS ////////////
   expectUserNotFound: ("principal": principal) -> () query;
   follow: ("principal": principal) -> ();
   getAgePayout: (ageId: nat, ago: nat) -> (Sharable__14) query;
   getAgePayouts: (ageId: nat) -> (Sharable__13) query;
   getAgesPayout: (ago: nat) -> (Sharable__13) query;
   getAgesPayouts: () -> (vec Sharable__13) query;
   /// PUBLIC ////// ACCESSORS ////////////
   getConfig: (key: Key) -> (SharableValue) query;
   getConfigs: () -> (Sharable__12) query;
   getEarning: ("principal": principal) -> (Sharable__11) query;
   getEvidence: (evidenceId: nat) -> (Sharable__9) query;
   getEvidences: (filter: Filter__3, sort: Sort_3) -> (Sharable__10) query;
   getEvidencesPagination: (filter: Filter__3, sort: Sort_3, page: nat,
    limit: nat) -> (Pagination_3) query;
   getField: (name: text) -> (Sharable__7) query;
   getFields: (filter: Filter__2, sort: Sort_2) -> (Sharable__8) query;
   getFieldsPagination: (filter: Filter__2, sort: Sort_2, page: nat, limit:
    nat) -> (Pagination_2) query;
   getFlag: (header: Header) -> (Sharable__5) query;
   getFlags: (filter: Filter__1, sort: Sort_1) -> (Sharable__6) query;
   getFlagsPagination: (filter: Filter__1, sort: Sort_1, page: nat, limit:
    nat) -> (Pagination_1) query;
   getHypotheses: (filter: Filter, sort: Sort) -> (Sharable__4) query;
   getHypothesesPagination: (filter: Filter, sort: Sort, page: nat, limit:
    nat) -> (Pagination) query;
   getHypothesis: (hypothesisId: nat) -> (Sharable__3) query;
   getTop: (category:
    variant {
      AcornEarners;
      EvidencePublishers;
      EvidenceVoters;
      HypothesisPublishers;
      HypothesisVoters;
      Influencers;
    }) -> (TopNonPagination) query;
   getTopPagination: (category:
    variant {
      AcornEarners;
      EvidencePublishers;
      EvidenceVoters;
      HypothesisPublishers;
      HypothesisVoters;
      Influencers;
    }, page: nat, limit: nat) -> (TopPagination) query;
   getUser: ("principal": principal) -> (Sharable__2) query;
   getUserConfigs: () -> (Sharable__1) query;
   /// PROTECTED ////// MODIFIERS ////////////
   initialize: () -> ();
   /// PUBLIC ////// MODIFIERS ////////////
   joinField: (fieldId: text) -> ();
   leaveField: (fieldId: text) -> ();
   publishEvidence: (hypothesisId: nat, form: Form, choice: Choice__1,
    repliedTo: opt nat) -> (nat);
   publishHypothesis: (fieldId: text, content: text) -> (nat);
   putConfigs: (entries: vec record {
                               Key;
                               SharableValue;
                             }) -> ();
   register: ("principal": principal) -> ();
   removeEvidenceVote: (evidenceId: nat) -> ();
   removeFlagVote: (header: Header) -> ();
   removeFromAxioms: (hypothesisId: nat) -> ();
   removeFromBookmarks: (hypothesisId: nat) -> ();
   removeHypothesisVote: (hypothesisId: nat) -> ();
   requestFlag: (header: Header, reason: text) -> ();
   restoreAllUserConfigs: () -> ();
   restoreUserConfig: ("variant": Variant) -> ();
   setAllUserConfigs: (configs: vec Sharable) -> ();
   setBatchUserConfigs: (configs: vec Sharable) -> ();
   setConfigs: (entries: vec record {
                               Key;
                               SharableValue;
                             }) -> ();
   setUserConfig: (config: Sharable) -> ();
   shiftToMidnight: (days: nat) -> ();
   unfollow: ("principal": principal) -> ();
   voteEvidence: (evidenceId: nat, choice: Choice__1, custom:
    opt CustomValue) -> ();
   voteFlag: (header: Header, choice: Choice__1) -> ();
   voteHypothesis: (hypothesisId: nat, choice: Choice, custom:
    opt CustomValue) -> ();
   withdrawAll: () -> ();
 };
service : () -> Axioms
