type Value_2 = 
 variant {
   infinity;
   value: ValueProp_2;
 };
type Value_1 = 
 variant {
   infinity;
   value: ValueProp_1;
 };
type ValueProp_2 = 
 variant {
   exclusive: nat;
   inclusive: nat;
 };
type ValueProp_1 = 
 variant {
   exclusive: int;
   inclusive: int;
 };
type ValueProp = 
 variant {
   exclusive: float64;
   inclusive: float64;
 };
type Value = 
 variant {
   infinity;
   value: ValueProp;
 };
type Sharable__2 = 
 vec record {
       Key;
       SharableValue;
     };
type Sharable__1 = vec SharableAchievementPackage;
type SharableValue = 
 variant {
   Bool: bool;
   Date: SharableDate;
   Duration: nat;
   E8S: SharableE8S;
   Float: float64;
   Nat: nat;
   Proportion: SharableProportion;
   RangeFloat: SharableRange;
   RangeInt: SharableRange_1;
   RangeNat: SharableRange_2;
   Text: text;
 };
type SharableRange_2 = 
 record {
   Value_2;
   Value_2;
 };
type SharableRange_1 = 
 record {
   Value_1;
   Value_1;
 };
type SharableRange = 
 record {
   Value;
   Value;
 };
type SharableProportion = 
 record {
   nat;
   nat;
 };
type SharablePackage = 
 record {
   capitalRaised: nat;
   metadata: Dip721NonFungibleToken;
   "principal": opt principal;
 };
type SharableE8S = nat;
type SharableDate = nat;
type SharableAchievementPackage = 
 record {
   achievement: Achievement;
   metadata: Dip721NonFungibleToken;
   "principal": opt principal;
 };
type Sharable = vec SharablePackage;
type Sales = 
 service {
   addAchievementPackage: (achievement: Achievement, name: text, symbol:
    text, logoUri: text) -> ();
   addPackage: (capitalRaised: nat, name: text, symbol: text, logoUri:
    text) -> ();
   computeAcornToMint: (capitalRaised: nat) -> (ACORNToMint);
   deployAchievementPackage: (achievement: Achievement) -> ();
   deployPackage: (capitalRaised: nat) -> ();
   expectPackageFound: (capitalRaised: nat) -> (nat) query;
   /// PUBLIC ////// ASSERTERS ////////////
   expectPackageNotFound: (capitalRaised: nat) -> () query;
   forceUpdateCapitalRaised: (users: vec principal) ->
    (ForceUpdateCapitalRaisedResult);
   getAchievementPackagePrincipals: () ->
    (vec record {
           Achievement;
           principal;
         }) query;
   getAchievementPackages: () -> (Sharable__1) query;
   /// PUBLIC ////// ACCESSORS ////////////
   getConfig: (key: Key) -> (SharableValue) query;
   getConfigs: () -> (Sharable__2) query;
   getOwnedAchievementPackages: ("principal": principal) -> (Sharable__1);
   getOwnedPackages: ("principal": principal) -> (Sharable);
   getPackagePrincipals: () -> (vec record {
                                      nat;
                                      principal;
                                    }) query;
   getPackages: () -> (Sharable) query;
   /// PROTECTED ////// MODIFIERS ////////////
   initialize: () -> ();
   mintAchievementPackage: (achievement: Achievement) -> ();
   mintPackage: (recipient: principal, capitalRaised: nat) -> (nat);
   putConfigs: (entries: vec record {
                               Key;
                               SharableValue;
                             }) -> ();
   setConfigs: (entries: vec record {
                               Key;
                               SharableValue;
                             }) -> ();
   /// PUBLIC ////// MODIFIERS ////////////
   upgradePackage: () -> ();
 };
type LogoResult = 
 record {
   data: text;
   logo_type: text;
 };
type Key = text;
type ForceUpdateCapitalRaisedResult = 
 record {
   failed: vec record {
                 principal;
                 text;
               };
   success: vec principal;
 };
type Dip721NonFungibleToken = 
 record {
   logo: LogoResult;
   maxLimit: nat16;
   name: text;
   symbol: text;
 };
type Achievement = 
 variant {
   OctupleBurial;
   Referral;
 };
type ACORNToMint = 
 record {
   buried: nat;
   liquid: nat;
 };
service : () -> Sales
