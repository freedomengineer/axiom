type Variant = 
 variant {
   ACORN;
   Affiliate;
   Axioms;
   DAO;
   Escrow;
   Facade;
   Founder;
   Frontend;
   ICPUSD;
   Indicator;
   Sales;
   Split;
   Treasury;
 };
type Value_2 = 
 variant {
   infinity;
   value: ValueProp_2;
 };
type Value_1 = 
 variant {
   infinity;
   value: ValueProp_1;
 };
type ValueProp_2 = 
 variant {
   exclusive: nat;
   inclusive: nat;
 };
type ValueProp_1 = 
 variant {
   exclusive: int;
   inclusive: int;
 };
type ValueProp = 
 variant {
   exclusive: float64;
   inclusive: float64;
 };
type Value = 
 variant {
   infinity;
   value: ValueProp;
 };
type Treasury = 
 service {
   claim: (principal, nat) -> ();
   delegatedClaim: (Variant, principal, nat) -> ();
   delegatedExternalTransfer: (Variant, principal, nat) -> ();
   externalMint: (principal, nat) -> ();
   externalTransfer: (principal, nat) -> ();
   getAllocated: (Variant) -> (Sharable) query;
   getAllocation: (Variant) -> (Sharable__3) query;
   getAllocations: () -> (Sharable__2) query;
   getBalance: (Variant) -> (Sharable) query;
   getCirculatingSupply: () -> (Sharable) query;
   /// PUBLIC ////// ACCESSORS ////////////
   getConfig: (Key) -> (SharableValue) query;
   getConfigs: () -> (Sharable__1) query;
   getReserveSupply: () -> (Sharable) query;
   getTotalSupply: () -> (Sharable) query;
   internalMint: (Variant, nat) -> ();
   internalTransfer: (Variant, nat) -> ();
   putConfigs: (vec record {
                      Key;
                      SharableValue;
                    }) -> ();
   /// PUBLIC ////// MODIFIERS ////////////
   setConfigs: (vec record {
                      Key;
                      SharableValue;
                    }) -> ();
 };
type Sharable__3 = 
 record {
   actorVariant: ActorVariant;
   allocated: nat;
   balance: nat;
 };
type Sharable__2 = vec SharableAllocation;
type Sharable__1 = 
 vec record {
       Key;
       SharableValue;
     };
type SharableValue = 
 variant {
   Bool: bool;
   Date: SharableDate;
   Duration: nat;
   E8S: SharableE8S;
   Float: float64;
   Nat: nat;
   Proportion: SharableProportion;
   RangeFloat: SharableRange;
   RangeInt: SharableRange_1;
   RangeNat: SharableRange_2;
   Text: text;
 };
type SharableRange_2 = 
 record {
   Value_2;
   Value_2;
 };
type SharableRange_1 = 
 record {
   Value_1;
   Value_1;
 };
type SharableRange = 
 record {
   Value;
   Value;
 };
type SharableProportion = 
 record {
   nat;
   nat;
 };
type SharableE8S = nat;
type SharableDate = nat;
type SharableAllocation = 
 record {
   actorVariant: ActorVariant;
   allocated: nat;
   balance: nat;
 };
type Sharable = nat;
type Key = text;
type ActorVariant = 
 variant {
   ACORN;
   Affiliate;
   Axioms;
   DAO;
   Escrow;
   Facade;
   Founder;
   Frontend;
   ICPUSD;
   Indicator;
   Sales;
   Split;
   Treasury;
 };
service : () -> Treasury
